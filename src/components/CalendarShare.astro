---
import { googleCalendarUrl, icsContent, whatsappShareUrl } from '../lib/calendar';
---

<div class="calshare" role="group" aria-label="Save the date and share">
  <a
    href={googleCalendarUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="csbtn"
    aria-label="Add to Google Calendar"
  >
    <svg class="cs-ic" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2.5" stroke="currentColor" stroke-width="1.4" />
      <rect x="3" y="3" width="18" height="3.6" fill="currentColor" opacity="0.18" />
      <circle cx="6" cy="5" r="0.7" fill="currentColor" opacity="0.7" />
      <circle cx="18" cy="5" r="0.7" fill="currentColor" opacity="0.7" />
      <text
        x="12" y="16.6"
        font-family="'Cormorant Garamond', Georgia, serif"
        font-size="8.5" font-weight="500"
        fill="currentColor" text-anchor="middle"
        letter-spacing="-0.3"
      >21</text>
    </svg>
    <span>Google Calendar</span>
  </a>

  <button class="csbtn" id="ics-btn" type="button" aria-label="Add to Apple or Outlook calendar (downloads .ics file)">
    <svg class="cs-ic" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="3.2" stroke="currentColor" stroke-width="1.4" />
      <rect x="3" y="3" width="18" height="3.6" fill="currentColor" opacity="0.35" />
      <text
        x="12" y="9.1"
        font-family="'Jost', sans-serif"
        font-size="2.4" font-weight="600"
        fill="var(--wine-d, #5a1b2a)" text-anchor="middle"
        letter-spacing="0.6"
      >CALENDAR</text>
      <text
        x="12" y="17.4"
        font-family="'Cormorant Garamond', Georgia, serif"
        font-size="9.5" font-weight="500"
        fill="currentColor" text-anchor="middle"
        letter-spacing="-0.4"
      >21</text>
    </svg>
    <span>Apple &middot; Outlook</span>
  </button>

  <a
    href={whatsappShareUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="csbtn"
    aria-label="Share on WhatsApp"
  >
    <svg class="cs-ic" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M20.46 3.49A11.78 11.78 0 0 0 12.04 0C5.49 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.94L0 24l6.31-1.65a11.84 11.84 0 0 0 5.72 1.45h.01c6.55 0 11.88-5.34 11.89-11.9 0-3.18-1.23-6.16-3.47-8.41ZM12.04 21.81h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.64-.24-.38a9.83 9.83 0 0 1-1.51-5.27c0-5.44 4.44-9.87 9.89-9.87 2.64 0 5.12 1.03 6.99 2.9a9.81 9.81 0 0 1 2.89 6.99c0 5.45-4.43 9.88-9.88 9.88Zm5.43-7.4c-.3-.15-1.76-.86-2.03-.96-.27-.1-.47-.15-.67.15-.2.29-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.03 1.01-1.03 2.47s1.06 2.87 1.21 3.07c.15.2 2.09 3.2 5.07 4.48.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.34Z"/>
    </svg>
    <span>Share on WhatsApp</span>
  </a>
</div>

<style>
  .calshare {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 1.6vw, 14px);
    justify-content: center;
    align-items: stretch;
    margin: 0 auto;
    max-width: 720px;
    position: relative;
  }

  /* All three pills share one fixed width/height so they read as a
     uniform set — never one longer than the others because "Google
     Calendar" has more letters than "Apple · Outlook". A fixed px
     font-size (no vw scaling) plus a shared min-width keeps every pill
     identical on every screen size, from small phones to desktop; they
     only ever reflow (3-up → 2+1 → stacked), never resize relative to
     each other. */
  .csbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex: 0 1 200px;
    min-width: 168px;
    max-width: 220px;
    background: transparent;
    border: 1px solid rgba(200, 169, 110, 0.45);
    color: rgba(237, 229, 212, 0.92);
    padding: 11px 16px;
    font-family: var(--sans);
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.15s ease;
    border-radius: 0;
    line-height: 1;
  }

  .csbtn:hover,
  .csbtn:focus-visible {
    background: rgba(200, 169, 110, 0.14);
    border-color: var(--gold);
    color: var(--ivory);
    transform: translateY(-1px);
  }

  .csbtn:active {
    transform: translateY(0);
  }

  .csbtn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .cs-ic {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }
</style>

<script is:inline define:vars={{ ics: icsContent }}>
  // @ts-nocheck — `ics` is injected by Astro's define:vars at render time.
  document.getElementById('ics-btn')?.addEventListener('click', () => {
    const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'dipika-jatin-wedding.ics';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>
