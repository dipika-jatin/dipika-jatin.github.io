---
import { wedding } from '../data/wedding';
---

<div
  class="cd"
  role="timer"
  aria-label={`Time remaining until ${wedding.bride} and ${wedding.groom}'s wedding`}
>
  <p class="cd-label">Counting down</p>
  <div class="cd-line">
    <span class="cd-unit">
      <span class="cd-num" id="cd-d">--</span>
      <span class="cd-lab">days</span>
    </span>
    <span class="cd-sep" aria-hidden="true">·</span>
    <span class="cd-unit">
      <span class="cd-num" id="cd-h">--</span>
      <span class="cd-lab">hrs</span>
    </span>
    <span class="cd-sep" aria-hidden="true">·</span>
    <span class="cd-unit">
      <span class="cd-num" id="cd-m">--</span>
      <span class="cd-lab">mins</span>
    </span>
    <span class="cd-sep" aria-hidden="true">·</span>
    <span class="cd-unit">
      <span class="cd-num" id="cd-s">--</span>
      <span class="cd-lab">secs</span>
    </span>
  </div>
</div>

<style>
  .cd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.6vw, 14px);
    opacity: 0;
    animation: fu-cd 1s ease 1.3s forwards;
  }

  .cd-label {
    font-family: var(--sans);
    font-size: clamp(9px, 1.1vw, 10.5px);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold-d);
    font-weight: 400;
  }

  .cd-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: clamp(10px, 2vw, 18px);
  }

  .cd-unit {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--serif);
    color: var(--wine);
  }

  .cd-num {
    font-size: clamp(20px, 3.2vw, 28px);
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    min-width: 1.5ch;
    text-align: right;
  }

  .cd-lab {
    font-family: var(--sans);
    font-size: clamp(8.5px, 1vw, 10px);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-l);
  }

  .cd-sep {
    font-family: var(--serif);
    color: var(--gold);
    opacity: 0.55;
    font-size: clamp(16px, 2.2vw, 20px);
    line-height: 1;
    align-self: center;
  }

  @keyframes fu-cd {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cd { animation: none; opacity: 1; }
  }
</style>

<script is:inline define:vars={{ targetIso: wedding.dateIso }}>
  // @ts-nocheck — `targetIso` is injected by Astro's define:vars at render time.
  // IST-pinned target: ISO carries the +05:30 offset, so this resolves to one
  // absolute UTC instant identical for every viewer worldwide.
  const target = new Date(targetIso).getTime();
  const elD = document.getElementById('cd-d');
  const elH = document.getElementById('cd-h');
  const elM = document.getElementById('cd-m');
  const elS = document.getElementById('cd-s');
  const pad2 = (n) => String(n).padStart(2, '0');

  function tick() {
    const diff = target - Date.now();
    if (diff <= 0) {
      if (elD) elD.textContent = '0';
      if (elH) elH.textContent = '00';
      if (elM) elM.textContent = '00';
      if (elS) elS.textContent = '00';
      return false;
    }
    if (elD) elD.textContent = String(Math.floor(diff / 86_400_000));
    if (elH) elH.textContent = pad2(Math.floor((diff % 86_400_000) / 3_600_000));
    if (elM) elM.textContent = pad2(Math.floor((diff % 3_600_000) / 60_000));
    if (elS) elS.textContent = pad2(Math.floor((diff % 60_000) / 1000));
    return true;
  }

  tick();
  const id = setInterval(() => { if (!tick()) clearInterval(id); }, 1000);
</script>
