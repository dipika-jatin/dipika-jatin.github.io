<div
  id="invitation-intro"
  class="intro"
  role="dialog"
  aria-modal="true"
  aria-labelledby="intro-label"
>
  <button
    class="intro-trigger"
    type="button"
    aria-label="Open Dipika and Jatin's wedding invitation"
  >
    <img
      class="intro-logo"
      src="/Logo.webp"
      alt="Dipika and Jatin wedding monogram, 20 and 21 November 2026"
      width="1024"
      height="1536"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      draggable="false"
    />
  </button>

  <div class="intro-prompt">
    <span id="intro-label" class="intro-label">Open the invitation</span>
    <span class="intro-prompt-line"></span>
  </div>
</div>

<script is:inline>
  document.documentElement.classList.add('intro-active');
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 48%, rgba(200, 169, 110, 0.1) 0%, transparent 36%),
      radial-gradient(ellipse 70% 85% at 50% 50%, var(--wine) 0%, var(--wine-d) 62%, #3f0d18 100%);
    isolation: isolate;
    transition: opacity 2s ease;
    will-change: opacity;
  }

  .intro[hidden] {
    display: none;
  }

  .intro::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      repeating-linear-gradient(
        110deg,
        rgba(255, 255, 255, 0.018) 0,
        rgba(255, 255, 255, 0.018) 1px,
        transparent 1px,
        transparent 5px
      );
    mix-blend-mode: soft-light;
    opacity: 0.55;
  }

  .intro-trigger {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: min(92vw, 620px);
    max-height: 94svh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--gold-l);
    font: inherit;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    touch-action: manipulation;
    animation: intro-arrive 1.1s var(--ease) both;
    transition: transform 3s var(--ease);
  }

  .intro-logo {
    display: block;
    width: min(86vw, 560px);
    height: auto;
    max-height: min(76svh, 620px);
    object-fit: contain;
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .intro-label {
    font-family: var(--sans);
    font-size: clamp(9px, 1.2vw, 11px);
    font-weight: 400;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(245, 240, 230, 0.82);
  }

  .intro-prompt {
    position: absolute;
    left: 50%;
    bottom: clamp(16px, 3vh, 28px);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transform: translateX(-50%);
    pointer-events: none;
    transition: opacity 0.45s ease, transform 0.55s var(--ease);
  }

  .intro-prompt-line {
    width: 1px;
    height: clamp(28px, 5vh, 46px);
    background: linear-gradient(180deg, var(--gold), transparent);
    transform-origin: top;
    animation: intro-line 2s ease-in-out infinite;
  }

  .intro-trigger:focus-visible {
    outline: none;
  }

  .intro.is-opening {
    pointer-events: none;
    opacity: 0;
  }

  .intro.is-opening .intro-logo {
    visibility: hidden;
  }

  @keyframes intro-arrive {
    from { opacity: 0; transform: translateY(18px) scale(0.975); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes intro-line {
    0%, 100% { opacity: 0.35; transform: scaleY(0.45); }
    50%      { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 600px) {
    .intro-trigger {
      width: 96vw;
    }

    .intro-logo {
      width: min(92vw, 470px);
      max-height: 74svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-trigger,
    .intro-logo {
      animation: none;
    }

    .intro-prompt-line {
      animation: none;
    }
  }

  :global(html.intro-active),
  :global(html.intro-active body) {
    overflow: hidden;
    overscroll-behavior: none;
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>('#invitation-intro');
  const trigger = intro?.querySelector<HTMLButtonElement>('.intro-trigger');
  const site = document.querySelector<HTMLElement>('#site');

  if (intro && trigger) {
    site?.setAttribute('inert', '');

    const openInvitation = () => {
      if (intro.classList.contains('is-opening')) return;

      intro.classList.add('is-opening');
      intro.setAttribute('aria-hidden', 'true');
      window.scrollTo({ top: 0, behavior: 'instant' });

      const finishOpening = () => {
        trigger.blur();
        intro.hidden = true;
        document.documentElement.classList.remove('intro-active');
        site?.removeAttribute('inert');
      };

      if ('animate' in intro) {
        intro.animate(
          [
            { opacity: 1 },
            { opacity: 0 },
          ],
          {
            duration: 2000,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'forwards',
          }
        ).finished.then(finishOpening);
      } else {
        window.setTimeout(finishOpening, 2100);
      }
    };

    trigger.addEventListener('click', openInvitation);
    intro.addEventListener('click', (event) => {
      if (event.target === intro) {
        openInvitation();
      }
    });
  }
</script>
