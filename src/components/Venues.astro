---
import { venues } from '../data/venues';
---

<section id="venue" aria-labelledby="venue-title">
  <p class="seye rv">Where to Find Us</p>
  <h2 id="venue-title" class="stitle rv d1">Venue Details</h2>
  <div class="sdiv rv d2" aria-hidden="true">
    <div class="sdivl"></div>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
      <path
        d="M8 0L9.8 6.2L16 8L9.8 9.8L8 16L6.2 9.8L0 8L6.2 6.2L8 0Z"
        fill="var(--gold)"
      />
    </svg>
    <div class="sdivl"></div>
  </div>

  <div class="vngrid">
    {venues.map((venue, idx) => (
      <article class={`vncard rv ${idx === 1 ? 'd1' : ''}`}>
        {venue.icon === 'hotel' ? (
          <svg class="vnico" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path
              d="M20 3C13.4 3 8 8.4 8 15c0 9.8 12 22 12 22s12-12.2 12-22c0-6.6-5.4-12-12-12z"
              stroke="var(--gold)"
              stroke-width="1.4"
            />
            <circle cx="20" cy="15" r="4" stroke="var(--gold)" stroke-width="1.4" />
          </svg>
        ) : (
          <svg class="vnico" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path d="M4 32V16L12 8H28L36 16V32" stroke="var(--gold)" stroke-width="1.4" />
            <rect x="14" y="22" width="12" height="10" stroke="var(--gold)" stroke-width="1.4" />
            <path d="M4 16H36" stroke="var(--gold)" stroke-width="1.4" />
            <path d="M20 8V32" stroke="var(--gold)" stroke-width="0.7" opacity="0.5" />
          </svg>
        )}
        <p class="vnlbl">{venue.label}</p>
        <h3 class="vnname">{venue.name}</h3>
        <address class="vnaddr">
          {venue.address.map((line, i) => (
            <>{line}{i < venue.address.length - 1 && <br />}</>
          ))}
        </address>
        <a
          href={venue.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="vnbtn"
          aria-label={`View ${venue.name} on Google Maps (opens in new tab)`}
        >
          View on Map →
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  #venue {
    background: var(--cream);
  }

  .vngrid {
    max-width: 880px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  @media (max-width: 640px) {
    .vngrid { grid-template-columns: 1fr; }
  }

  .vncard {
    background: var(--ivory);
    padding: clamp(28px, 4vw, 40px) clamp(24px, 3.5vw, 36px);
    border: 1px solid rgba(200, 169, 110, 0.25);
    position: relative;
    overflow: hidden;
  }

  .vncard::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .vnico {
    width: 38px;
    height: 38px;
    margin-bottom: 18px;
    color: var(--gold);
  }

  .vnlbl {
    font-size: clamp(9px, 1.2vw, 10px);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold-d);
    margin-bottom: 7px;
  }

  .vnname {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(20px, 2.8vw, 26px);
    color: var(--text);
    margin-bottom: 7px;
  }

  .vnaddr {
    font-size: clamp(12px, 1.5vw, 13px);
    font-weight: 300;
    font-style: normal;
    color: var(--text-l);
    line-height: 1.75;
    margin-bottom: 18px;
  }

  .vnbtn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: clamp(10px, 1.2vw, 11px);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--wine);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(123, 36, 53, 0.3);
    transition: border-color 0.2s, gap 0.2s;
  }

  .vnbtn:hover,
  .vnbtn:focus-visible {
    border-color: var(--wine);
    gap: 11px;
  }

  .vnbtn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }
</style>
