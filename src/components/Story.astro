---
---

<section id="story" aria-labelledby="story-title">
  <header class="story-head">
    <p class="seye rv">Our Journey</p>
    <h2 id="story-title" class="stitle rv d1">Our Story</h2>
    <div class="sdiv rv d2" aria-hidden="true">
      <div class="sdivl"></div>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path
          d="M8 0L9.8 6.2L16 8L9.8 9.8L8 16L6.2 9.8L0 8L6.2 6.2L8 0Z"
          fill="var(--gold)"
        />
      </svg>
      <div class="sdivl"></div>
    </div>
  </header>

  {/* Both illustrations share one gapless horizontal track, preserving their
      detail while presenting the journey as one continuous swipe. */}
  <figure class="pano-wrap rv">
    <div
      class="pano-scroll"
      tabindex="0"
      role="region"
      aria-label="Our illustrated journey. Swipe or scroll horizontally to explore."
    >
      <div class="pano-track">
        <img
          class="pano-img"
          src="/story/panorama-1.webp"
          alt="The first chapter of Dipika and Jatin's illustrated journey, from school days in Kolkata through college and long-distance years."
          width="2172"
          height="724"
          loading="lazy"
          decoding="async"
        />
        <img
          class="pano-img"
          data-src="/story/panorama-2.webp"
          alt="The next chapter of Dipika and Jatin's illustrated journey, from studying and celebrating together to Hyderabad and their wedding."
          width="2161"
          height="728"
          decoding="async"
        />
      </div>
    </div>
    <span class="pano-hint" aria-hidden="true">
      <span class="pano-hint-txt">Swipe through our story</span>
      <span class="pano-hint-chevrons">
        <svg viewBox="0 0 24 24" width="14" height="14"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <svg viewBox="0 0 24 24" width="14" height="14"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </span>
  </figure>

  <footer class="story-end rv">
    <div class="end-rule" aria-hidden="true"></div>
    <p class="end-line">And now, we get to celebrate the next chapter with you.</p>
  </footer>
</section>

<style>
  #story {
    background: var(--ivory);
    padding: clamp(60px, 10vw, 100px) 0 clamp(70px, 11vw, 110px);
    overflow: hidden;
  }

  .story-head {
    text-align: center;
    padding: 0 clamp(20px, 5vw, 48px);
    margin-bottom: clamp(36px, 6vw, 56px);
  }

  /* ── Panorama ────────────────────────────────────────────────────────── */
  .pano-wrap {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }
  .pano-scroll {
    position: relative;
    border-radius: 14px;
    background: var(--cream);
    box-shadow:
      0 1px 0 rgba(200, 169, 110, 0.45) inset,
      0 24px 60px -32px rgba(58, 46, 31, 0.35),
      0 2px 10px -4px rgba(58, 46, 31, 0.08);
    outline: 1px solid rgba(200, 169, 110, 0.32);
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 94%, transparent 100%);
            mask-image: linear-gradient(90deg, #000 0, #000 94%, transparent 100%);
  }
  .pano-scroll:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 5px;
  }
  .pano-scroll.dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }
  .pano-scroll::-webkit-scrollbar {
    display: none;
  }
  .pano-track {
    display: flex;
    width: max-content;
    height: clamp(230px, 28vw, 360px);
  }
  .pano-img {
    display: block;
    flex: none;
    width: auto;
    height: 100%;
    max-width: none;
    user-select: none;
    pointer-events: none;
  }
  .pano-img + .pano-img {
    margin-left: -1px;
  }
  /* A floating pill badge, not a quiet caption — sits on top of the image
     itself (not tucked below it) so it reads as a UI affordance rather
     than decoration, with an animated double-chevron that visibly
     "nudges" sideways to suggest the swipe gesture. It fades away the
     moment the visitor actually scrolls the panorama, since its job is
     done once they've discovered it. */
  .pano-hint {
    display: inline-flex;
    position: absolute;
    right: clamp(14px, 4vw, 24px);
    bottom: 14px;
    align-items: center;
    gap: 7px;
    padding: 8px 10px 8px 16px;
    border-radius: 999px;
    background: rgba(44, 36, 22, 0.82);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    color: var(--ivory);
    box-shadow: 0 8px 20px -8px rgba(44, 36, 22, 0.6);
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .pano-hint.show {
    opacity: 1;
    animation: pano-hint-in 0.5s var(--ease) both;
  }
  .pano-hint-txt {
    font-family: var(--sans);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
  }
  .pano-hint-chevrons {
    display: inline-flex;
    align-items: center;
    margin-left: -4px;
  }
  .pano-hint-chevrons svg {
    color: var(--gold-l);
    animation: pano-chevron 1.4s ease-in-out infinite;
  }
  .pano-hint-chevrons svg:nth-child(1) { margin-right: -8px; animation-delay: 0s; }
  .pano-hint-chevrons svg:nth-child(2) { animation-delay: 0.18s; }

  @keyframes pano-hint-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pano-chevron {
    0%, 100% { opacity: 0.35; transform: translateX(0); }
    50%      { opacity: 1; transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pano-hint-chevrons svg { animation: none; opacity: 0.8; }
  }

  @media (max-width: 760px) {
    .pano-wrap {
      padding-inline: clamp(4px, 1.5vw, 8px);
    }
    .pano-scroll {
      border-radius: 10px;
    }
  }

  /* ── Closing ─────────────────────────────────────────────────────────── */
  .story-end {
    text-align: center;
    margin: clamp(56px, 8vw, 88px) auto 0;
    max-width: 640px;
    padding: 0 clamp(20px, 5vw, 48px);
  }
  .end-rule {
    width: 56px;
    height: 1px;
    background: var(--gold);
    opacity: 0.55;
    margin: 0 auto clamp(20px, 3vw, 26px);
  }
  .end-line {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(17px, 2vw, 21px);
    color: var(--gold-d);
    line-height: 1.55;
    letter-spacing: 0.01em;
    margin: 0;
  }

</style>

<script>
  // Swipe hint: appear once the panorama scrolls into view, then fade
  // away the moment the visitor actually swipes it — no point nagging
  // once they've found it.
  const panoScroll = document.querySelector<HTMLElement>('.pano-scroll');
  const panoHint = document.querySelector<HTMLElement>('.pano-hint');
  if (panoScroll && panoHint) {
    // Once the critical page load is complete, warm both panorama files in
    // the browser cache during idle time. This keeps the hero fast while
    // making the story ready before most visitors scroll down to it.
    const firstPano = panoScroll.querySelector<HTMLImageElement>('img[src]');
    // Begin fetching chapter two before the visitor reaches this section,
    // so the continuous track is ready by the time they swipe.
    const secondPano = panoScroll.querySelector<HTMLImageElement>('img[data-src]');
    const warmPanoramas = () => {
      const sources = [firstPano?.src, secondPano?.dataset.src];
      for (const source of sources) {
        if (!source) continue;
        const preload = new Image();
        preload.decoding = 'async';
        preload.src = source;
      }
    };
    const scheduleWarmup = () => {
      const requestIdle = (
        window as unknown as {
          requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
        }
      ).requestIdleCallback;
      if (requestIdle) {
        requestIdle(warmPanoramas, { timeout: 2000 });
      } else {
        window.setTimeout(warmPanoramas, 500);
      }
    };
    if (document.readyState === 'complete') {
      scheduleWarmup();
    } else {
      window.addEventListener('load', scheduleWarmup, { once: true });
    }

    if (secondPano) {
      const loadSecondPano = () => {
        const src = secondPano.dataset.src;
        if (!src) return;
        secondPano.src = src;
        delete secondPano.dataset.src;
      };

      if ('IntersectionObserver' in window) {
        const preloadIo = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              loadSecondPano();
              preloadIo.disconnect();
            }
          },
          { rootMargin: '1200px 0px' }
        );
        preloadIo.observe(panoScroll);
      } else {
        loadSecondPano();
      }
    }

    if ('IntersectionObserver' in window) {
      const hintIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              panoHint.classList.add('show');
              hintIo.disconnect();
            }
          }
        },
        { threshold: 0.4 }
      );
      hintIo.observe(panoScroll);
    } else {
      panoHint.classList.add('show');
    }

    panoScroll.addEventListener(
      'scroll',
      () => {
        panoHint.classList.remove('show');
      },
      { passive: true, once: true }
    );

    // Native touch swiping handles mobile. This small pointer enhancement
    // gives mouse users the same grab-and-drag interaction on desktop.
    let dragging = false;
    let startX = 0;
    let startScrollLeft = 0;

    panoScroll.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') return;
      dragging = true;
      startX = event.clientX;
      startScrollLeft = panoScroll.scrollLeft;
      panoScroll.classList.add('dragging');
      panoScroll.setPointerCapture(event.pointerId);
    });

    panoScroll.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      panoScroll.scrollLeft = startScrollLeft - (event.clientX - startX);
    });

    const stopDragging = () => {
      dragging = false;
      panoScroll.classList.remove('dragging');
    };
    panoScroll.addEventListener('pointerup', stopDragging);
    panoScroll.addEventListener('pointercancel', stopDragging);
  }
</script>
