---
import { wedding } from '../data/wedding';
import CalendarShare from './CalendarShare.astro';
---

<section id="save-the-date" aria-labelledby="std-title">
  <p class="seye">Mark Your Calendar</p>
  <h2 id="std-title" class="stitle">Save the Date</h2>
  <div class="sdiv" aria-hidden="true">
    <div class="sdivl"></div>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
      <path
        d="M8 0L9.8 6.2L16 8L9.8 9.8L8 16L6.2 9.8L0 8L6.2 6.2L8 0Z"
        fill="rgba(200,169,110,.45)"
      />
    </svg>
    <div class="sdivl"></div>
  </div>
  <p class="rsub">
    Add 20–21 November 2026 to your calendar — or share with someone you love.
  </p>

  <div class="std-share">
    <CalendarShare />
  </div>

  <p class="rnote">
    For queries · <a href={`mailto:${wedding.contactEmail}`}>{wedding.contactEmail}</a>
  </p>
</section>

<style>
  #save-the-date {
    background: var(--wine);
    text-align: center;
    padding: clamp(60px, 10vw, 100px) clamp(20px, 5vw, 48px);
  }

  #save-the-date .seye { color: rgba(200, 169, 110, 0.75); }
  #save-the-date .stitle { color: var(--ivory); }
  #save-the-date .sdivl { background: rgba(200, 169, 110, 0.4); }

  .rsub {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 300;
    color: rgba(237, 229, 212, 0.8);
    margin: 0 auto clamp(36px, 6vh, 56px);
    max-width: 480px;
    letter-spacing: 0.05em;
    line-height: 1.55;
  }

  .std-share {
    max-width: 540px;
    margin: 0 auto;
  }

  .rnote {
    font-size: 11px;
    font-weight: 300;
    color: rgba(200, 169, 110, 0.55);
    margin-top: clamp(32px, 5vh, 48px);
    letter-spacing: 0.05em;
    text-align: center;
  }

  .rnote a {
    color: rgba(200, 169, 110, 0.85);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
