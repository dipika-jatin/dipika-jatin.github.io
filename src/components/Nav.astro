---
import { wedding } from '../data/wedding';
---

<nav id="mn" aria-label="Primary">
  <a href="#hero" class="nmono" aria-label={`${wedding.bride} and ${wedding.groom} — home`}>
    {wedding.monogram}
  </a>
  <ul class="nlinks">
    <li><a href="#events">Events</a></li>
    <li><a href="#story">Our Story</a></li>
    <li><a href="#venue">Venues</a></li>
    <li><a href="#save-the-date">Save the Date</a></li>
  </ul>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 18px clamp(20px, 4vw, 48px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(245, 240, 230, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(200, 169, 110, 0.18);
    transition: padding 0.3s;
  }

  nav.sc {
    padding: 12px clamp(20px, 4vw, 48px);
  }

  .nmono {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    letter-spacing: 0.04em;
    color: var(--wine);
    text-decoration: none;
  }

  .nlinks {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    list-style: none;
  }

  .nlinks a {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-l);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nlinks a:hover,
  .nlinks a:focus-visible {
    color: var(--wine);
  }

  .nlinks a:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    .nlinks { display: none; }
  }
</style>

<script>
  // Shrink nav on scroll
  const nav = document.getElementById('mn');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('sc', window.scrollY > 50);
  });
</script>
